import { supabase } from './supabase';
import type {
  Incident,
  IncidentMember,
  MatchIncidentResponse,
  MemberRole,
} from './types';

type MatchPayload = {
  action: 'join' | 'ping';
  transit_line: string;
  direction: string;
  lat: number;
  lng: number;
  heading?: number | null;
  speed?: number | null;
  car_number?: string | null;
  incident_id?: string;
};

async function invokeMatchIncident(payload: MatchPayload): Promise<MatchIncidentResponse> {
  const { data, error } = await supabase.functions.invoke('match-incident', {
    body: payload,
  });

  if (error) {
    throw error;
  }

  return data as MatchIncidentResponse;
}

export async function reportNuisance(
  transitLine: string,
  direction: string,
  lat: number,
  lng: number,
  heading: number | null,
  speed: number | null,
  carNumber: string | null,
): Promise<MatchIncidentResponse> {
  return invokeMatchIncident({
    action: 'join',
    transit_line: transitLine.trim(),
    direction: direction.trim(),
    lat,
    lng,
    heading,
    speed,
    car_number: carNumber?.trim() || null,
  });
}

export async function pingIncident(
  incidentId: string,
  transitLine: string,
  direction: string,
  lat: number,
  lng: number,
  heading: number | null,
  speed: number | null,
  carNumber: string | null,
): Promise<MatchIncidentResponse> {
  return invokeMatchIncident({
    action: 'ping',
    incident_id: incidentId,
    transit_line: transitLine.trim(),
    direction: direction.trim(),
    lat,
    lng,
    heading,
    speed,
    car_number: carNumber?.trim() || null,
  });
}

export async function setMemberRole(incidentId: string, role: MemberRole): Promise<void> {
  const { data: userData } = await supabase.auth.getUser();
  const userId = userData.user?.id;
  if (!userId) {
    throw new Error('Not signed in');
  }

  if (role === 'confronter') {
    const { data: existing } = await supabase
      .from('incident_members')
      .select('id')
      .eq('incident_id', incidentId)
      .eq('role', 'confronter')
      .maybeSingle();

    if (existing) {
      throw new Error('Someone is already the confronter');
    }
  }

  const { error } = await supabase
    .from('incident_members')
    .update({ role })
    .eq('incident_id', incidentId)
    .eq('user_id', userId);

  if (error) {
    throw error;
  }
}

export async function triggerGo(incidentId: string): Promise<void> {
  const { error } = await supabase
    .from('incidents')
    .update({ status: 'go', go_at: new Date().toISOString() })
    .eq('id', incidentId);

  if (error) {
    throw error;
  }
}

export async function closeIncident(incidentId: string): Promise<void> {
  const { error } = await supabase
    .from('incidents')
    .update({ status: 'closed' })
    .eq('id', incidentId);

  if (error) {
    throw error;
  }
}

export async function getIncident(incidentId: string): Promise<Incident | null> {
  const { data, error } = await supabase
    .from('incidents')
    .select('*')
    .eq('id', incidentId)
    .maybeSingle();

  if (error) {
    throw error;
  }

  return data;
}

export async function getIncidentMembers(incidentId: string): Promise<IncidentMember[]> {
  const { data, error } = await supabase
    .from('incident_members')
    .select(
      `
      id,
      incident_id,
      user_id,
      role,
      last_lat,
      last_lng,
      heading,
      speed,
      joined_at,
      profile:profiles (
        id,
        display_name,
        shirt_color
      )
    `,
    )
    .eq('incident_id', incidentId)
    .order('joined_at', { ascending: true });

  if (error) {
    throw error;
  }

  return (data ?? []).map((row) => ({
    ...row,
    profile: Array.isArray(row.profile) ? row.profile[0] : row.profile,
  })) as IncidentMember[];
}

export function subscribeToIncident(
  incidentId: string,
  onChange: () => void,
): () => void {
  const channel = supabase
    .channel(`incident:${incidentId}`)
    .on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'incident_members', filter: `incident_id=eq.${incidentId}` },
      () => onChange(),
    )
    .on(
      'postgres_changes',
      { event: '*', schema: 'public', table: 'incidents', filter: `id=eq.${incidentId}` },
      () => onChange(),
    )
    .subscribe();

  return () => {
    void supabase.removeChannel(channel);
  };
}

export function countOthers(members: IncidentMember[], userId: string): number {
  return members.filter((member) => member.user_id !== userId).length;
}

export function getConfronter(members: IncidentMember[]): IncidentMember | undefined {
  return members.find((member) => member.role === 'confronter');
}

export function countPartners(members: IncidentMember[]): number {
  return members.filter((member) => member.role === 'partner').length;
}

export function isReadyGroup(members: IncidentMember[]): boolean {
  return Boolean(getConfronter(members)) && countPartners(members) >= 1;
}
